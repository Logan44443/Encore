# Copy to apps/mobile/.env (gitignored) and restart Expo with `npx expo start -c`.
# Supabase dashboard > Project Settings > Data API > Project URL
EXPO_PUBLIC_SUPABASE_URL=
# Supabase dashboard > Project Settings > API Keys > Publishable key (sb_publishable_…).
# Safe to ship in the app; Row Level Security protects the data. Never the secret key.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional: the API's address. Without it the app uses port 4000 on the computer running Expo.
EXPO_PUBLIC_API_URL=
