PORT=4000

# Leave empty to use the embedded Postgres (PGlite) stored in ./.data — zero setup.
# Set to a real Postgres URL for production, e.g. postgres://encore:encore@localhost:5432/encore
DATABASE_URL=

# Required in production: a random string of at least 32 characters (e.g. `openssl rand -base64 48`).
JWT_SECRET=

# Set to 1 when the API runs behind a proxy or load balancer (Railway, Fly, Render…) so
# login rate limits use the real client IP from X-Forwarded-For. Leave unset otherwise.
TRUST_PROXY=

# Comma-separated list of allowed browser origins ("*" allows all; fine since auth uses bearer tokens).
CORS_ORIGINS=*

# Movies & TV — free key at https://www.themoviedb.org/settings/api
# Provide either the v3 API key or the v4 "API Read Access Token". Without one, a small demo catalog is used.
TMDB_API_KEY=
TMDB_READ_TOKEN=

# Concert setlists — free key at https://api.setlist.fm/docs/1.0/index.html
SETLISTFM_API_KEY=

# MusicBrainz requires an identifying User-Agent: "AppName/version (contact-email-or-url)"
MUSICBRAINZ_USER_AGENT=Encore/0.1 (you@example.com)
