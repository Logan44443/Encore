PORT=4000

# ---- Supabase (Project Settings in the Supabase dashboard) -------------------
# Never commit real values: .env is gitignored. In production these go in Render's Environment page.
# Connect > Session pooler: postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# (URL-encode any special characters in the password.) The direct connection is IPv6-only, so use the pooler.
DATABASE_URL=
# Connections the API keeps open to the pooler. Free-tier pools are small; 5 is plenty for one server.
DATABASE_POOL_SIZE=5
# Project Settings > Data API > Project URL, e.g. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=
# Project Settings > API Keys > Secret key (sb_secret_…). Server only: never put it in the app.
SUPABASE_SECRET_KEY=

# Set to 1 when the API runs behind a proxy or load balancer (Render, Fly…) so
# login rate limits use the real client IP from X-Forwarded-For. Leave unset otherwise.
TRUST_PROXY=

# Comma-separated list of allowed browser origins ("*" allows all; fine since auth uses bearer tokens).
CORS_ORIGINS=*

# Movies & TV — free key at https://www.themoviedb.org/settings/api
# Provide either the v3 API key or the v4 "API Read Access Token". Without one, a small demo catalog is used.
TMDB_API_KEY=
TMDB_READ_TOKEN=

# Concert setlists — free key at https://api.setlist.fm/docs/1.0/index.html
SETLISTFM_API_KEY=

# MusicBrainz requires an identifying User-Agent: "AppName/version (contact-email-or-url)"
MUSICBRAINZ_USER_AGENT=Encore/0.1 (you@example.com)

# Books come from Open Library, which needs no key.
# Optional: a Google Books key fills in covers and descriptions Open Library is missing.
# Free at https://console.cloud.google.com/apis/library/books.googleapis.com (create an API key under Credentials).
GOOGLE_BOOKS_API_KEY=
